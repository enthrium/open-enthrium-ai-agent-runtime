{
  "llm": {
    "provider": "openai",
    "model": "gpt-4o",
    "apiKey": "YOUR_OPENAI_API_KEY"
  },
  "server": {
    "enabled": false,
    "port": 3333,
    "apiKey": "your-secret-api-key"
  },
  "connectors": [
    {
      "_comment": "--- email ---",
      "connection_name": "My Email",
      "connection_type": "gmail-rest",
      "bearerToken": "YOUR_GOOGLE_ACCESS_TOKEN",
      "baseUrl": "https://gmail.googleapis.com/gmail/v1/users/me"
    },
    {
      "_comment": "--- sql-databases ---",
      "connection_name": "My Database",
      "connection_type": "postgresql",
      "host": "localhost",
      "port": 5432,
      "database": "mydb",
      "user": "postgres",
      "password": "YOUR_DB_PASSWORD"
    },
    {
      "_comment": "--- ssh ---",
      "connection_name": "My Server",
      "connection_type": "ssh",
      "host": "192.168.1.100",
      "port": 22,
      "username": "ubuntu",
      "privateKey": "-----BEGIN OPENSSH PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END OPENSSH PRIVATE KEY-----"
    },
    {
      "_comment": "--- cloud-drives ---",
      "connection_name": "My Google Drive",
      "connection_type": "google-drive",
      "bearerToken": "YOUR_GOOGLE_ACCESS_TOKEN",
      "baseUrl": "https://www.googleapis.com/drive/v3"
    },
    {
      "_comment": "--- web-search ---",
      "connection_name": "Perplexity",
      "connection_type": "perplexity-search",
      "bearerToken": "YOUR_PERPLEXITY_API_KEY",
      "baseUrl": "https://api.perplexity.ai"
    },
    {
      "_comment": "--- team-messaging ---",
      "connection_name": "My Slack",
      "connection_type": "slack",
      "botToken": "xoxb-YOUR-BOT-TOKEN",
      "channel": "general"
    },
    {
      "_comment": "--- productivity-crm ---",
      "connection_name": "GitHub",
      "connection_type": "github",
      "token": "ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN",
      "owner": "your-org",
      "repo": "your-repo"
    },
    {
      "_comment": "--- rest-api ---",
      "connection_name": "Target API",
      "connection_type": "http",
      "baseUrl": "https://jsonplaceholder.typicode.com"
    },
    {
      "_comment": "--- image-generation ---",
      "connection_name": "OpenAI Image",
      "connection_type": "openai-image",
      "bearerToken": "YOUR_OPENAI_API_KEY",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-image-1"
    },
    {
      "_comment": "--- nosql-cache ---",
      "connection_name": "My MongoDB",
      "connection_type": "mongodb",
      "uri": "mongodb://localhost:27017",
      "database": "mydb"
    },
    {
      "_comment": "--- telegram ---",
      "connection_name": "My Telegram Bot",
      "connection_type": "telegram",
      "baseUrl": "https://api.telegram.org/botYOUR_BOT_TOKEN"
    },
    {
      "_comment": "--- ocr-vision ---",
      "connection_name": "Azure Vision",
      "connection_type": "azure-vision",
      "apiKey": "YOUR_AZURE_VISION_KEY",
      "headerName": "Ocp-Apim-Subscription-Key",
      "baseUrl": "https://YOUR_RESOURCE.cognitiveservices.azure.com/vision/v3.2"
    },
    {
      "_comment": "--- local-exec ---",
      "connection_name": "Local Shell",
      "connection_type": "shell",
      "cwd": ".",
      "timeout": 30
    },
    {
      "_comment": "--- graphql ---",
      "connection_name": "My GraphQL API",
      "connection_type": "graphql",
      "endpoint": "https://api.example.com/graphql",
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN"
      }
    },
    {
      "_comment": "--- message-queues ---",
      "connection_name": "My Kafka",
      "connection_type": "kafka",
      "brokers": ["localhost:9092"],
      "clientId": "oe-runtime",
      "topic": "my-topic"
    },
    {
      "_comment": "--- iot-messaging ---",
      "connection_name": "MQTT Broker",
      "connection_type": "mqtt",
      "broker": "mqtt://localhost:1883",
      "clientId": "oe-runtime",
      "topic": "devices/#",
      "username": "YOUR_MQTT_USER",
      "password": "YOUR_MQTT_PASSWORD"
    },
    {
      "_comment": "--- music-generation ---",
      "connection_name": "Suno",
      "connection_type": "suno",
      "bearerToken": "YOUR_KIE_AI_API_KEY",
      "baseUrl": "https://api.kie.ai/api/v1"
    },
    {
      "_comment": "--- speech-audio ---",
      "connection_name": "ElevenLabs",
      "connection_type": "elevenlabs",
      "apiKey": "YOUR_ELEVENLABS_API_KEY",
      "headerName": "xi-api-key",
      "baseUrl": "https://api.elevenlabs.io/v1"
    },
    {
      "_comment": "--- video-generation ---",
      "connection_name": "OpenAI",
      "connection_type": "restApi",
      "baseUrl": "https://api.openai.com/v1",
      "headers": {
        "Authorization": "Bearer YOUR_OPENAI_API_KEY",
        "Content-Type": "application/json"
      }
    },
    {
      "connection_name": "Canva",
      "connection_type": "restApi",
      "baseUrl": "https://api.canva.com/rest/v1",
      "headers": {
        "Authorization": "Bearer YOUR_CANVA_ACCESS_TOKEN",
        "Content-Type": "application/json"
      }
    },
    {
      "_comment": "--- blockchain-web3 ---",
      "connection_name": "Ethereum",
      "connection_type": "web3",
      "baseUrl": "https://ethereum.publicnode.com",
      "walletAddress": "0xYOUR_WALLET_ADDRESS"
    },
    {
      "_comment": "--- file-storage ---",
      "connection_name": "My S3 Bucket",
      "connection_type": "s3",
      "region": "us-east-1",
      "bucket": "YOUR_BUCKET_NAME",
      "accessKeyId": "YOUR_AWS_ACCESS_KEY_ID",
      "secretAccessKey": "YOUR_AWS_SECRET_ACCESS_KEY"
    },
    {
      "_comment": "--- blog-to-video ---",
      "connection_name": "Blog",
      "connection_type": "restApi",
      "baseUrl": "https://www.openenthrium.com"
    },
    {
      "_comment": "--- directory-identity ---",
      "connection_name": "Active Directory",
      "connection_type": "ldap",
      "url": "ldap://YOUR_AD_HOST:389",
      "baseDN": "dc=yourcompany,dc=com",
      "username": "cn=admin,dc=yourcompany,dc=com",
      "password": "YOUR_LDAP_PASSWORD"
    }
  ]
}
